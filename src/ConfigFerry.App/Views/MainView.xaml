<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConfigFerry.App.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConfigFerry.App.Views">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Account -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ConfigFerry" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Sign in with Microsoft Entra ID"
                Command="{x:Bind ViewModel.SignInCommand}"
                Content="Sign in with Microsoft"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Command="{x:Bind ViewModel.SignOutCommand}"
                Content="Sign out"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind local:MainView.HasText(ViewModel.StatusMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind local:MainView.MapSeverity(ViewModel.StatusSeverity), Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,12,0" Spacing="20">

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="1 · Source: Azure" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="DisplayName"
                            Header="Tenant (directory)"
                            IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Tenants}"
                            PlaceholderText="Select a tenant"
                            SelectedItem="{x:Bind ViewModel.SelectedTenant, Mode=TwoWay}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="DisplayName"
                            Header="Subscription"
                            IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Subscriptions}"
                            PlaceholderText="Select a subscription"
                            SelectedItem="{x:Bind ViewModel.SelectedSubscription, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="DisplayName"
                                Header="App Service / Function App"
                                IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.AppServices}"
                                PlaceholderText="Select an app"
                                SelectedItem="{x:Bind ViewModel.SelectedAppService, Mode=TwoWay}" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Bottom"
                                IsActive="{x:Bind ViewModel.IsLoadingAppServices, Mode=OneWay}" />
                        </Grid>
                        <Button
                            AutomationProperties.Name="Reload subscriptions"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            Content="Reload" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="2 · Target" />
                        <RadioButton
                            Content="Generate JSON (copy to clipboard)"
                            GroupName="Target"
                            IsChecked="{x:Bind ViewModel.IsJsonTarget, Mode=TwoWay}" />
                        <RadioButton
                            Content="Merge into an existing file"
                            GroupName="Target"
                            IsChecked="{x:Bind ViewModel.IsFileTarget, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsFileTarget, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.Name="Selected settings file"
                                IsReadOnly="True"
                                PlaceholderText="No file selected"
                                Text="{x:Bind ViewModel.SelectedFilePath, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseFileCommand}"
                                Content="Browse…" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="3 · Format" />
                        <RadioButton
                            Content="appsettings.json (ASP.NET / .NET app)"
                            GroupName="Format"
                            IsChecked="{x:Bind ViewModel.IsAppSettingsFormat, Mode=TwoWay}" />
                        <RadioButton
                            Content="local.settings.json (Azure Function)"
                            GroupName="Format"
                            IsChecked="{x:Bind ViewModel.IsFunctionsFormat, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Options" />
                        <CheckBox
                            Content="Resolve Key Vault references"
                            IsChecked="{x:Bind ViewModel.ResolveKeyVaultReferences, Mode=TwoWay}" />
                        <CheckBox
                            Content="Exclude Azure platform settings (WEBSITE_*, …)"
                            IsChecked="{x:Bind ViewModel.ExcludePlatformSettings, Mode=TwoWay}" />
                        <CheckBox
                            Content="Include connection strings"
                            IsChecked="{x:Bind ViewModel.IncludeConnectionStrings, Mode=TwoWay}" />
                        <CheckBox
                            Content="Create .bak backup before saving"
                            IsChecked="{x:Bind ViewModel.CreateBackup, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsFileTarget, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GenerateCommand}"
                        Content="Generate"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Result -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Preview" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                        Content="Copy" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.SaveToFileCommand}"
                        Content="Save to file"
                        Visibility="{x:Bind ViewModel.IsFileTarget, Mode=OneWay}" />
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Generated configuration preview"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    PlaceholderText="The generated JSON appears here."
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                    TextWrapping="NoWrap" />

                <ItemsControl
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Warnings}"
                    Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

